// Single source of truth for the schema, shared by `api` and the extracted `worker` via the
// generated client in this package rather than each runtime owning its own copy.
// The `reservations` no-overlap guarantee is NOT expressed here: it is a GiST exclusion
// constraint added by a raw SQL migration alongside these Prisma migrations, because
// Prisma's schema DSL cannot represent exclusion constraints.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  HOST
}

// Reservation lifecycle: HELD -> CONFIRMED on payment success, HELD -> CANCELLED
// on payment failure (compensation), HELD -> EXPIRED when hold_expires_at passes unpaid (swept by
// a scheduled job), CONFIRMED -> COMPLETED after the stay. Only HELD/CONFIRMED are considered
// "active" by the exclusion constraint's WHERE clause; the rest never block a slot.
enum ReservationStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Host-defined calendar windows: OPEN/CLOSED marks a listing's availability
// independent of actual reservations.
enum AvailabilityKind {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  listings      Listing[]
  reservations  Reservation[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Listing {
  id                String   @id @default(uuid()) @db.Uuid
  hostId            String   @map("host_id") @db.Uuid
  title             String
  city              String
  nightlyPriceCents Int      @map("nightly_price_cents")
  maxGuests         Int      @map("max_guests")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  host               User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  availabilityBlocks AvailabilityBlock[]
  reservations       Reservation[]

  @@index([city])
  @@index([hostId])
  @@map("listings")
}

model AvailabilityBlock {
  id        String           @id @default(uuid()) @db.Uuid
  listingId String           @map("listing_id") @db.Uuid
  startsAt  DateTime         @map("starts_at") @db.Timestamptz()
  endsAt    DateTime         @map("ends_at") @db.Timestamptz()
  kind      AvailabilityKind

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("availability_blocks")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  listingId       String            @map("listing_id") @db.Uuid
  guestId         String            @map("guest_id") @db.Uuid
  checkIn         DateTime          @map("check_in") @db.Timestamptz
  checkOut        DateTime          @map("check_out") @db.Timestamptz
  status          ReservationStatus @default(HELD)
  priceTotalCents Int               @map("price_total_cents")
  // TTL for an unpaid HELD reservation; a scheduled sweep transitions rows past this timestamp to
  // EXPIRED (design.md §7), which removes them from the exclusion constraint's active set.
  holdExpiresAt   DateTime          @map("hold_expires_at") @db.Timestamptz
  // Not yet load-bearing: version-based optimistic locking was evaluated and rejected as the
  // overlap-prevention mechanism (the exclusion constraint owns that). Reserved for a future
  // optimistic-concurrency need on this row, not currently read or incremented by application code.
  version         Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest    User      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  payments Payment[]
  review   Review?

  // No-overlap is enforced by a GiST EXCLUSION CONSTRAINT added in a raw SQL migration.
  // The constraint indexes the expression tstzrange(check_in, check_out, '[)') directly, so there
  // is NO separate range column for Prisma to track. Prisma does not model exclusion constraints.

  @@index([listingId])
  @@index([guestId])
  @@index([status])
  @@map("reservations")
}

// idempotencyKey is unique because the worker charges the mock provider keyed by this value: a
// redelivered charge message finds the existing row and returns its result instead of charging
// twice. That is what makes at-least-once delivery from the outbox safe.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  reservationId  String        @map("reservation_id") @db.Uuid
  status         PaymentStatus @default(PENDING)
  providerRef    String?       @map("provider_ref")
  idempotencyKey String        @unique @map("idempotency_key")
  amountCents    Int           @map("amount_cents")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("payments")
}

// Transactional outbox: written in the same DB transaction as the domain change it announces
// so the event can never be lost or phantom-emitted relative
// to that change. A polling relay selects publishedAt IS NULL rows and pushes them to BullMQ
// using SELECT ... FOR UPDATE SKIP LOCKED, so multiple relay instances can't double-publish the
// same row -- the index below serves that poll query.
model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  type        String
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([publishedAt])
  @@map("outbox")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @unique @map("reservation_id") @db.Uuid
  rating        Int
  body          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // A rotation lineage: every token minted from one login shares a familyId. On reuse detection
  // the whole family is revoked at once — that is what turns a stolen token into a signal.
  familyId  String    @map("family_id") @db.Uuid
  // Only the SHA-256 of the raw token is stored. The token is high-entropy random, so a fast hash
  // is sufficient (Argon2 is for low-entropy passwords); the DB never holds anything replayable.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  // Set when the token is rotated or the family is revoked. A non-null value on a presented
  // token means replay.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
