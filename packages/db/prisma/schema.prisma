// Single source of truth for the schema, shared by `api` and the extracted `worker` through the
// client generated here, rather than each runtime owning a copy that can drift.
//
// This file is not the whole truth about the database. The central guarantee -- that two active
// reservations on a listing cannot overlap -- is a GiST exclusion constraint installed by a raw SQL
// migration alongside these Prisma migrations, because Prisma's DSL cannot express one. Read the
// Reservation model with that in mind.

datasource db {
  // No `url` here by design: prisma.config.ts injects it from DATABASE_URL, keeping the connection
  // string out of a checked-in file.
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  HOST
}

// Reservation lifecycle: HELD -> CONFIRMED on payment success, HELD -> CANCELLED
// on payment failure (compensation), HELD -> EXPIRED when hold_expires_at passes unpaid (swept by
// a scheduled job), CONFIRMED -> COMPLETED after the stay. Only HELD/CONFIRMED are considered
// "active" by the exclusion constraint's WHERE clause; the rest never block a slot.
enum ReservationStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Host-defined calendar windows: OPEN/CLOSED marks a listing's availability
// independent of actual reservations.
enum AvailabilityKind {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  listings      Listing[]
  reservations  Reservation[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Listing {
  id                String   @id @default(uuid()) @db.Uuid
  hostId            String   @map("host_id") @db.Uuid
  title             String
  city              String
  nightlyPriceCents Int      @map("nightly_price_cents")
  maxGuests         Int      @map("max_guests")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  host               User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  availabilityBlocks AvailabilityBlock[]
  reservations       Reservation[]
  reviews            Review[]

  @@index([city])
  @@index([hostId])
  @@map("listings")
}

model AvailabilityBlock {
  id        String           @id @default(uuid()) @db.Uuid
  listingId String           @map("listing_id") @db.Uuid
  startsAt  DateTime         @map("starts_at") @db.Timestamptz()
  endsAt    DateTime         @map("ends_at") @db.Timestamptz()
  kind      AvailabilityKind

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("availability_blocks")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  listingId       String            @map("listing_id") @db.Uuid
  guestId         String            @map("guest_id") @db.Uuid
  checkIn         DateTime          @map("check_in") @db.Timestamptz
  checkOut        DateTime          @map("check_out") @db.Timestamptz
  status          ReservationStatus @default(HELD)
  priceTotalCents Int               @map("price_total_cents")
  // TTL for an unpaid hold. A background sweep transitions rows past this timestamp to EXPIRED,
  // which drops them from the constraint's active set and returns the slot to the pool. Without it,
  // an abandoned checkout would hold a date range hostage forever.
  holdExpiresAt   DateTime          @map("hold_expires_at") @db.Timestamptz
  // Not load-bearing. Optimistic locking was considered as the overlap-prevention mechanism and
  // rejected in favor of the exclusion constraint, which cannot be bypassed by a caller who forgets
  // to check. Kept for a future optimistic-concurrency need; no application code reads or bumps it.
  version         Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  // Restrict, not Cascade: a reservation is financial history, and a host tidying up their listings
  // must not be able to erase a booking someone paid for. Postgres refuses the delete outright, so the
  // guarantee holds for a direct API call as much as for the interface. Withdrawing a listing from
  // sale is what `active` is for -- it hides the listing without destroying what happened on it.
  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guest    User      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  payments Payment[]
  review   Review?

  // No-overlap lives in the `no_overlapping_active_reservations` GiST exclusion constraint, added by
  // a raw SQL migration. It indexes the expression tstzrange(check_in, check_out, '[)') over the two
  // columns above, so there is no range column here to find -- do not add one.
  //
  // Two consequences worth knowing before touching this model. The bounds are half-open: a check-out
  // and the next check-in may fall on the same instant, so same-day turnover is not an overlap. And
  // conflicting concurrent inserts are settled by the database, which rejects the loser, rather than
  // by any read-then-write check in application code -- there is no window between the two to lose.

  @@index([listingId])
  @@index([guestId])
  @@index([status])
  @@map("reservations")
}

// Ledger of charge attempts. No application code writes this table yet: the worker charges the
// provider and reports the outcome over the result queue, where redelivery is absorbed by a
// deterministic job id rather than by a row here. The table is defined ahead of that code.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  reservationId  String        @map("reservation_id") @db.Uuid
  status         PaymentStatus @default(PENDING)
  providerRef    String?       @map("provider_ref")
  // Carries the reservation id, and is unique so that at most one charge can ever be recorded per
  // booking. Delivery from the outbox is at-least-once, so the same charge can be attempted more
  // than once; this constraint turns the second attempt into a collision the database rejects,
  // rather than a double-charge that a read-then-write check could race past.
  idempotencyKey String        @unique @map("idempotency_key")
  amountCents    Int           @map("amount_cents")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  failureReason  String?       @map("failure_reason")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("payments")
}

// Transactional outbox. The event row is written in the same transaction as the domain change it
// announces, so the two commit or roll back together: an event can never describe a change that was
// rolled back, and a committed change can never fail to announce itself. Writing to the queue
// directly would give up exactly that -- the process can die between the commit and the publish.
//
// A relay polls for unpublished rows with SELECT ... FOR UPDATE SKIP LOCKED and pushes them to the
// queue, so relay instances claim disjoint rows and never publish the same one twice. Publishing is
// therefore at-least-once, not exactly-once: consumers must be idempotent. The index below serves
// that poll.
model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  type        String
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([publishedAt])
  @@map("outbox")
}

// A guest's verdict on a stay. The reservation is the evidence the stay happened -- and being unique,
// it is also what limits a guest to one review per booking, enforced by the database rather than by a
// check the application could race past.
model Review {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @unique @map("reservation_id") @db.Uuid
  // Duplicated from the reservation, and written only by the server from the reservation it just
  // authorised -- never from the request. A review is *about a listing*, so carrying the listing here
  // lets reviews and their average be read with one indexed query instead of a join through the
  // reservations table, which belongs to another module. The cost is a copied column: it is set once
  // at insert and never updated, because a review cannot move to a different stay.
  listingId     String   @map("listing_id") @db.Uuid
  rating        Int
  body          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("reviews")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // A rotation lineage: every token minted from one login shares a familyId. On reuse detection
  // the whole family is revoked at once — that is what turns a stolen token into a signal.
  familyId  String    @map("family_id") @db.Uuid
  // Only the SHA-256 of the raw token is stored. The token is high-entropy random, so a fast hash
  // is sufficient (Argon2 is for low-entropy passwords); the DB never holds anything replayable.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  // Set when the token is rotated or the family is revoked. A non-null value on a presented
  // token means replay.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
