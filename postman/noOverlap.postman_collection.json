{
  "info": {
    "name": "noOverlap API",
    "description": "API test collection for the noOverlap booking platform.\n\nUsage:\n1. Start the API: `pnpm --filter api dev` (Postgres + Redis must be up via `docker compose up -d`).\n2. Run **Auth > Register** once, then **Auth > Login** — Login stores the access token in the `accessToken` collection variable, and Postman's cookie jar stores the HttpOnly refresh cookie automatically.\n3. Protected routes inherit `Authorization: Bearer {{accessToken}}` from the collection.\n\nThe collection tracks Phase 1.3 as it is built: Register + Login exist now; Refresh, Logout, and Me are added in 1.3.3 / 1.3.4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "guest@example.com" },
    { "key": "password", "value": "correct-horse-battery-staple" },
    { "key": "role", "value": "GUEST" },
    { "key": "accessToken", "value": "" },
    { "key": "listingId", "value": "" },
    { "key": "availabilityId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 on first run; 409 if this email is already registered (both are expected).",
                  "pm.test('registered (201) or already exists (409)', () =>",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('response omits the password hash', () =>",
                  "    pm.expect(body).to.not.have.property('passwordHash'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a user. Password is Argon2id-hashed; email uniqueness is enforced by the DB (duplicate -> 409 problem+json)."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('accessToken present', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.test('refresh cookie set (HttpOnly)', () => {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(setCookie).to.include('refresh_token');",
                  "  pm.expect(setCookie).to.match(/HttpOnly/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Verify credentials -> RS256 access token in the body + rotating refresh token in an HttpOnly cookie."
          }
        },
        {
          "name": "Login - invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('generic invalid-credentials envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.title).to.eql('Invalid credentials');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"definitely-the-wrong-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Wrong password returns the same 401 as an unknown email (no user enumeration, timing-equalized)."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('new accessToken issued', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.test('refresh cookie rotated', () => {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(setCookie).to.include('refresh_token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Reads the refresh_token cookie (Postman's jar sends it), rotates it in place, and returns a new access token. Reuse-detection check: log in, Refresh once (rotates), then replay an OLD refresh token -> the whole family is revoked and every later Refresh returns 401 until you log in again."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revokes the refresh-token family and clears the cookie. Idempotent (no cookie -> still 204)."
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns the caller identity', () => {",
                  "  pm.expect(body.userId).to.be.a('string');",
                  "  pm.expect(body.role).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Protected route. Inherits Authorization: Bearer {{accessToken}} from the collection (set by Login). Returns 401 without a valid access token."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness/readiness: checks Postgres + Redis. 200 when healthy, 503 when a dependency is down."
          }
        }
      ]
    },
    {
      "name": "Listings",
      "description": "Host-only, owner-scoped listing management (1.5). Log in as a HOST first: set the `role` variable to HOST, Register a fresh email, then Login.",
      "item": [
        {
          "name": "Create listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id, 'listing id').to.be.a('string');",
                  "pm.collectionVariables.set('listingId', body.id);",
                  "pm.test('owned by the caller (hostId set)', () => pm.expect(body.hostId).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sunny loft near Alexanderplatz\",\n  \"city\": \"Berlin\",\n  \"nightlyPriceCents\": 8900,\n  \"maxGuests\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": ["{{baseUrl}}"],
              "path": ["listings"]
            },
            "description": "Create a listing. Requires a HOST token (inherited bearer). A GUEST token -> 403."
          }
        },
        {
          "name": "Update listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nightlyPriceCents\": 9500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}"]
            },
            "description": "Update your own listing. Another host's listing -> 403; unknown id -> 404."
          }
        },
        {
          "name": "Delete listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}"]
            },
            "description": "Delete your own listing. 204 on success."
          }
        },
        {
          "name": "List active listings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('array of listings', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": ["{{baseUrl}}"],
              "path": ["listings"]
            },
            "description": "Public browse of active listings, newest first. Append ?city=Berlin to filter by city."
          }
        },
        {
          "name": "List my listings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/mine",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "mine"]
            },
            "description": "The host's own listings, active and inactive. Requires a HOST token (inherited bearer)."
          }
        },
        {
          "name": "Get listing by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}"]
            },
            "description": "Public read of a single listing. 404 if the id is unknown."
          }
        },
        {
          "name": "Add availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('availabilityId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startsAt\": \"2026-08-01T14:00:00.000Z\",\n  \"endsAt\": \"2026-08-10T11:00:00.000Z\",\n  \"kind\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}", "availability"]
            },
            "description": "Add an availability window to your own listing. An inverted range (startsAt >= endsAt) -> 400."
          }
        },
        {
          "name": "List availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}", "availability"]
            },
            "description": "Public: availability windows for a listing, earliest first. Unknown listing -> 404."
          }
        },
        {
          "name": "Delete availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/availability/{{availabilityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}", "availability", "{{availabilityId}}"]
            },
            "description": "Remove an availability window from your own listing. 204 on success."
          }
        }
      ]
    }
  ]
}
