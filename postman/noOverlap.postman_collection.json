    {
      "name": "Reservations",
      "description": "A guest places a hold on a date range. The Postgres exclusion constraint guarantees no two overlapping active holds on one listing — exactly one of N racers wins, the rest get 409. Any authenticated user can hold (log in as a GUEST for realism, or reuse the host token). NOTE: holds persist in the DB, so before running this folder create a FRESH listing (Listings > Create listing) — otherwise the fixed dates below are already held from a previous run and 'Create hold (A)' will itself return 409.",
      "item": [
        {
          "name": "Create hold (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status is HELD', () => pm.expect(body.status).to.eql('HELD'));",
                  "pm.test('price computed server-side', () => pm.expect(body.priceTotalCents).to.be.a('number'));",
                  "pm.test('hold expiry set', () => pm.expect(body.holdExpiresAt).to.be.a('string'));",
                  "pm.collectionVariables.set('reservationId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"checkIn\": \"2026-08-01T15:00:00.000Z\",\n  \"checkOut\": \"2026-08-05T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations"
              ]
            },
            "description": "Place a HELD reservation. Price = nights x nightly_price_cents (computed on the server); hold_expires_at = now + HOLD_TTL. guestId comes from the token, never the body. Saves the new id to `reservationId`."
          }
        },
        {
          "name": "Create hold - overlap (B) -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('slot-taken envelope', () =>",
                  "  pm.expect(pm.response.json().title).to.eql('Reservation slot no longer available'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"checkIn\": \"2026-08-03T15:00:00.000Z\",\n  \"checkOut\": \"2026-08-06T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations"
              ]
            },
            "description": "Overlaps hold A (Aug 3-6 vs Aug 1-5). The DB exclusion constraint rejects it (SQLSTATE 23P01); the service maps that to RESERVATION_SLOT_TAKEN. Run 'Create hold (A)' first."
          }
        },
        {
          "name": "Create hold - turnover (C) -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('status is HELD', () => pm.expect(pm.response.json().status).to.eql('HELD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"checkIn\": \"2026-08-05T11:00:00.000Z\",\n  \"checkOut\": \"2026-08-08T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations"
              ]
            },
            "description": "Back-to-back stay: check-in equals A's check-out. The half-open '[)' bounds mean this is NOT an overlap — same-day turnover is allowed."
          }
        },
        {
          "name": "Create hold - invalid range (D) -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('validation envelope', () =>",
                  "  pm.expect(pm.response.json().title).to.eql('Validation failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"checkIn\": \"2026-08-20T15:00:00.000Z\",\n  \"checkOut\": \"2026-08-10T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations"
              ]
            },
            "description": "check-out before check-in -> 400 VALIDATION_FAILED (detail: 'checkOut must be after checkIn.')."
          }
        },
        {
          "name": "List my reservations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('array of reservations', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "mine"
              ]
            },
            "description": "The caller's own reservations, newest first. Scoped by guestId from the token — a guest never sees another guest's holds."
          }
        },
        {
          "name": "Get reservation by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('id matches', () =>",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reservationId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            },
            "description": "Guest-scoped read of one reservation. Another guest's reservation id -> 404 (existence hidden, not 403)."
          }
        },
        {
          "name": "Cancel -> CANCELLED (frees the slot)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('reservation is CANCELLED', () =>",
                  "  pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}",
                "cancel"
              ]
            },
            "description": "Transitions to CANCELLED (compensation). The slot is now free — re-run an overlapping 'Create hold' and it succeeds (201) where it previously returned 409. A CONFIRMED reservation cancelled here also enqueues a refund, under the same idempotency key the charge settled with."
          }
        },
        {
          "name": "List received (host)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/received",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "received"
              ]
            },
            "description": "Every reservation made against the calling host's own listings. Requires a HOST token — sign in as the host first, or this returns 403. Declared before the `:id` route so the literal path segment is not captured by the UUID pipe."
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "description": "A stay can be reviewed only by the guest who took it, only once, and only after it has ended.\n\nOnly the refusals can be demonstrated from Postman alone: a review needs a COMPLETED reservation, and a reservation only reaches COMPLETED once its check-out is in the past and the completion sweep has run — neither of which any endpoint can force. To see the 201, backdate a confirmed reservation in psql and wait for the sweep (or restart the API, which runs it on its next tick):\n\n  UPDATE reservations SET check_in = now() - interval '6 days', check_out = now() - interval '3 days' WHERE id = '<reservationId>';",
      "item": [
        {
          "name": "Create review - stay not finished -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('refused as premature, not as missing', () =>",
                  "  pm.expect(pm.response.json().type).to.include('review-stay-not-finished'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"rating\": 5,\n  \"body\": \"Lovely place.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            },
            "description": "Acts on the last hold saved to `reservationId`. A conflict rather than a 404, because the request is well-formed and merely premature — the same call succeeds once the stay has ended."
          }
        },
        {
          "name": "Create review - another guest's reservation -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('reads as missing, not forbidden', () =>",
                  "  pm.expect(pm.response.json().type).to.include('not-found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"00000000-0000-4000-8000-000000000000\",\n  \"rating\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            },
            "description": "A reservation that is not yours returns exactly what a reservation that does not exist returns. Sign in as a second guest and send a real `reservationId` belonging to the first: the response is identical to this one. That is deliberate — a distinguishable 403 would let reservation ids be probed for existence."
          }
        },
        {
          "name": "Create review - rating out of range -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"rating\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews"
              ]
            },
            "description": "Validation runs before any eligibility check, so a malformed request never reveals whether the reservation exists."
          }
        },
        {
          "name": "Get listing reviews + rating",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('an unreviewed listing reports null, not zero', () => {",
                  "  const b = pm.response.json();",
                  "  if (b.count === 0) pm.expect(b.averageRating).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}",
                "reviews"
              ]
            },
            "description": "Public: reviews are what a guest reads while deciding whether to book, so they are not behind an account. A listing nobody has reviewed reports `averageRating: null` rather than 0 — zero is a rating a listing can genuinely earn, and reporting it for \"nothing said yet\" would be untrue."
          }
        }
      ]
    }
  ]
}
